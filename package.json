{
  "name": "wakeless",
  "version": "0.1.0",
  "private": true,
  "description": "Work a large cross-chain swap in randomized slices through NEAR Intents, settled confidentially.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wakeless": "bin/wakeless.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "demo": "node bin/wakeless.mjs run examples/usdc-arb-to-sol.json --speed 60",
    "impact": "node bin/wakeless.mjs impact --from usdc:arb --to sol:sol --usd 1000,10000,50000,100000,250000,500000,1000000",
    "check": "node bin/wakeless.mjs check"
  }
}
