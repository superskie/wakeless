# Copy to .env (git-ignored) and fill in. Dry runs need nothing here.

# Partner API key from https://partners.near-intents.org (API keys page).
# Needed for confidential quotes. Check it with: node bin/wakeless.mjs check
ONECLICK_API_KEY=

# Live mode: NEAR Intents Agent API. The hackathon demo deployment issues keys in
# its partner portal, https://partners.demo.agentsonintents.com/dashboard. Keys
# made before the portal (naa_...) are refused with api_key_retired.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com

# Written by `node live/agent.mjs owner`, `create` and `grant`. Keep them secret.
# AGENT_OWNER_EVM_PRIVATE_KEY=
# WAKELESS_AGENT_ID=
# WAKELESS_GRANT_TOKEN=
